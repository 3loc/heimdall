# heimdall@ted — captures Ted's voice from a USB mic on agneta.
#
# Not enabled by default. To activate:
#   1. Plug in the USB mic on agneta
#   2. Find its ALSA card index: `arecord -l`
#   3. Copy this file to /etc/heimdall/ted.env (the .example suffix removed)
#   4. Update HEIMDALL_AUDIO_DEVICE to match the real card (e.g. hw:3)
#   5. sudo systemctl enable --now heimdall@ted.service
#
# Once enabled, mimir consumes /run/heimdall/ted.sock alongside
# /run/heimdall/meeting.sock and tags the resulting transcript chunks
# as [TED] vs [MEETING] purely from the source — no pyannote needed.

HEIMDALL_LABEL=ted

# Replace this with the real card index after `arecord -l`
HEIMDALL_AUDIO_DEVICE=hw:3

HEIMDALL_AUDIO_SOCKET=/run/heimdall/ted.sock
HEIMDALL_AUDIO_RATE=16000
HEIMDALL_AUDIO_CHANNELS=1

# No video on the Ted instance — only the meeting instance touches /dev/video0.
HEIMDALL_VIDEO_ENABLED=0

# Different HTTP port from the meeting instance so they don't collide.
HEIMDALL_HTTP_HOST=127.0.0.1
HEIMDALL_HTTP_PORT=7101
