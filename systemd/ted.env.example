# heimdall@ted — captures ambient room audio from any USB mic plugged
# into agneta (webcam, headset, lavalier, USB conference mic, etc).
#
# Uses HEIMDALL_AUDIO_CARD_NAME=auto so it picks up whatever capture
# device is currently plugged in, preferring USB-Audio class cards
# over the internal HDA codecs and skipping the Elgato (which is
# owned by heimdall@meeting). Unplug one mic and plug in another and
# the next recovery loop iteration picks it up — no config edit
# required.
#
# To activate:
#   1. Plug in any USB mic on agneta
#   2. Copy this file to /etc/heimdall/ted.env (drop the .example)
#   3. sudo systemctl enable --now heimdall@ted.service
#
# Once enabled, mimir consumes /run/heimdall/ted.sock alongside
# /run/heimdall/meeting.sock and tags the resulting transcript chunks
# as [TED] vs [MEETING] purely from the source — no pyannote needed.

HEIMDALL_LABEL=ted

# Auto-detect any plugged-in capture device. To pin a specific mic
# instead, set HEIMDALL_AUDIO_CARD_NAME=<name from /proc/asound/cards>
# (e.g. C920) or use HEIMDALL_AUDIO_DEVICE=hw:N as an escape hatch.
HEIMDALL_AUDIO_CARD_NAME=auto

# Comma-separated card names to skip during auto-detect. Defaults to
# "Neo" so heimdall@ted never accidentally claims the Elgato away
# from heimdall@meeting. Add more here if agneta gains other cards
# that should never be picked up as a room mic.
HEIMDALL_AUDIO_AUTODETECT_EXCLUDE=Neo

HEIMDALL_AUDIO_SOCKET=/run/heimdall/ted.sock
HEIMDALL_AUDIO_RATE=16000
HEIMDALL_AUDIO_CHANNELS=1

# No video on the Ted instance — only the meeting instance touches /dev/video0.
HEIMDALL_VIDEO_ENABLED=0

# Different HTTP port from the meeting instance so they don't collide.
HEIMDALL_HTTP_HOST=0.0.0.0
HEIMDALL_HTTP_PORT=7101
