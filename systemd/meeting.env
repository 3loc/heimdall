# heimdall@meeting — captures the meeting audio and video from the Elgato.
#
# This is the default capture instance. Audio comes from the Elgato Game
# Capture Neo's USB Audio Class device (currently ALSA card 0 on agneta),
# video from /dev/video0. Resamples to 16 kHz mono PCM and fans out over
# /run/heimdall/meeting.sock for mimir (transcribe).

HEIMDALL_LABEL=meeting
HEIMDALL_AUDIO_DEVICE=hw:0
HEIMDALL_AUDIO_SOCKET=/run/heimdall/meeting.sock
HEIMDALL_AUDIO_RATE=16000
HEIMDALL_AUDIO_CHANNELS=1
HEIMDALL_VIDEO_ENABLED=1
HEIMDALL_VIDEO_DEVICE=/dev/video0
# Bind on the LAN, not just localhost — heimdall is a LAN service
# (same trust model as zerokb, which also binds 0.0.0.0). Reachable
# from the Mac Studio at http://agneta.local:7100/ or
# http://192.168.10.13:7100/.
HEIMDALL_HTTP_HOST=0.0.0.0
HEIMDALL_HTTP_PORT=7100
