# heimdall@meeting — captures the meeting audio and video from the Elgato.
#
# This is the default capture instance. Audio comes from the Elgato Game
# Capture Neo's USB Audio Class device (currently ALSA card 0 on agneta),
# video from /dev/video0. Resamples to 16 kHz mono PCM and fans out over
# /run/heimdall/meeting.sock for mimir (transcribe).

HEIMDALL_LABEL=meeting
# Name-based lookup — survives USB renumbering (the Elgato can land
# on any card index depending on plug order after the FeinTech splitter
# was added to the chain).
HEIMDALL_AUDIO_CARD_NAME=Neo
HEIMDALL_AUDIO_SOCKET=/run/heimdall/meeting.sock
HEIMDALL_AUDIO_RATE=16000
HEIMDALL_AUDIO_CHANNELS=1
HEIMDALL_VIDEO_ENABLED=1
# Stable by-id symlink — survives /dev/videoN renumbering.
HEIMDALL_VIDEO_DEVICE=/dev/v4l/by-id/usb-Elgato_Elgato_Game_Capture_Neo_A7BRB4101163JR-video-index0
# Background frame warmer — grabs a fresh frame every 1/FPS seconds
# so the snapshot POST handler returns in <2 ms instead of ~900 ms.
# Set to 0 to disable (fall back to on-demand cold grabs).
# Higher = fresher frames but more CPU. Each grab is ~900 ms of one
# core (ffmpeg spawn + v4l2 warm-up + PNG encode), so FPS > 1 means
# grabs overlap and one core is busy most of the time. 0.5 gives a
# good balance: frame is at most ~2.9 s old, CPU is ~31% of one core.
HEIMDALL_VIDEO_WARMER_FPS=1
# Bind on the LAN, not just localhost — heimdall is a LAN service
# (same trust model as zerokb, which also binds 0.0.0.0). Reachable
# from the Mac Studio at http://agneta.local:7100/ or
# http://192.168.10.13:7100/.
HEIMDALL_HTTP_HOST=0.0.0.0
HEIMDALL_HTTP_PORT=7100
