# heimdall@ted — captures Ted's voice from the Audeze Maxwell 2
# headset connected to agneta via Bluetooth (classic BR/EDR).
#
# The Maxwell 2 mic appears as a PipeWire source (not an ALSA card),
# so this instance uses HEIMDALL_AUDIO_FORMAT=pulse to read via
# ffmpeg's PulseAudio input, which PipeWire handles transparently.
#
# To activate:
#   1. Pair & connect the Maxwell 2:  bluetoothctl connect E0:49:ED:05:A0:B8
#   2. sudo cp ted.env /etc/heimdall/ted.env
#   3. sudo systemctl enable --now heimdall@ted.service
#
# Once enabled, mimir consumes /run/heimdall/ted.sock alongside
# /run/heimdall/meeting.sock and tags the resulting transcript chunks
# as [TED] vs [MEETING] purely from the source — no pyannote needed.

HEIMDALL_LABEL=ted

# PipeWire/PulseAudio input — the Maxwell 2 has no ALSA card entry.
# XDG_RUNTIME_DIR is needed so ffmpeg can find PipeWire's PulseAudio
# socket at /run/user/1000/pulse/native.
HEIMDALL_AUDIO_FORMAT=pulse
HEIMDALL_AUDIO_DEVICE=bluez_input.E0:49:ED:05:A0:B8
XDG_RUNTIME_DIR=/run/user/1000

HEIMDALL_AUDIO_SOCKET=/run/heimdall/ted.sock
HEIMDALL_AUDIO_RATE=16000
HEIMDALL_AUDIO_CHANNELS=1

# No video on the Ted instance — only the meeting instance touches /dev/video0.
HEIMDALL_VIDEO_ENABLED=0

# Different HTTP port from the meeting instance so they don't collide.
HEIMDALL_HTTP_HOST=0.0.0.0
HEIMDALL_HTTP_PORT=7101
